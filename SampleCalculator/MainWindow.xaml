<Window x:Class="SampleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SampleCalculator"
        mc:Ignorable="d"
        Title="SampleCalculator" 
        MinWidth="250" MinHeight="450"
        Height="500" Width="300"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="AliceBlue"
            BorderBrush="Gray"
            BorderThickness="3 3 1 1"
            Margin="2 0 2 2"
            Height="100"
            >
            <TextBlock
                x:Name="textBlock"
                Text=""
                FontFamily="Arial"
                FontSize="30"
                TextAlignment="Right"
                VerticalAlignment="Bottom"
            />
        </Border>
        <UniformGrid Rows="6" Columns="4" Grid.Row="1">
            <Button Content="%" FontSize="20"/>
            <Button Content="CE" FontSize="20"/>
            <Button Content="C" FontSize="20"/>
            <Button Content="&#8656;" FontSize="20"/>
            <Button Content="1/x" FontSize="20"/>
            <Button Content="x²" FontSize="20"/>
            <Button Content="&#8730;x" FontSize="20"/>
            <Button Content="÷" FontSize="20"/>
            <Button Content="7" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="8" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="9" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="×" FontSize="20"/>
            <Button Content="4" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="5" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="6" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="-" FontSize="20"/>
            <Button Content="1" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="2" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="3" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="+" FontSize="20"/>
            <Button Content="+/-" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="0" Background="WhiteSmoke" FontSize="20"/>
            <Button Content="," Background="WhiteSmoke" FontSize="20"/>
            <Button Content="=" FontSize="20"/>
        </UniformGrid>
    </Grid>
</Window>
