<Window x:Class="LengthCircleApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:cnv="clr-namespace:LengthCircleApp.Views.Converters"
        xmlns:vm="clr-namespace:LengthCircleApp.ViewModels"
        mc:Ignorable="d"
        Title="LengthCircle" Height="200" Width="600" MinHeight="180" MinWidth="400">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <cnv:VisibilityConverter x:Key="visibilityConverter"/>
        <cnv:ResultConverter x:Key="resultConverter"/>
        <cnv:TextConverter x:Key="textConverter"/>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Grid>
        <GroupBox Header="Длина окружности" 
                  Foreground="Silver" 
                  Margin="10" 
                  Padding="5" 
                  BorderBrush="Silver" 
                  BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Row="0"
                         Grid.Column="0"
                         Text="0.0"
                         FontSize="18"
                         Foreground="Gray"
                         Visibility="{Binding ElementName=txbRadius, Path=Text, Converter={StaticResource visibilityConverter}}"
                         IsHitTestVisible="False"/>
                <TextBox x:Name="txbRadius"
                         Grid.Row="0"
                         Grid.Column="0"
                         Background="Transparent"
                         MaxLength="12"
                         Text="{Binding Path=Radius, Converter={StaticResource textConverter}}"
                         FontSize="18">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewTextInput">
                            <i:InvokeCommandAction 
                                Command="{Binding PreviewTextInputCommand}"
                                PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewKeyDown">
                            <i:InvokeCommandAction 
                                Command="{Binding PreviewKeyDownCommand}"
                                PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Label Grid.Row="1" 
                       Grid.Column="0" 
                       HorizontalAlignment="Center">
                    <TextBlock TextAlignment="Center">Введите значение<LineBreak/>радиуса</TextBlock>
                </Label>
                
                <Button x:Name="btnCalculate" 
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Content="Рассчитать"
                        FontSize="18"
                        Margin="10,0,10,0"
                        Command="{Binding Path=CalculateCommand}"/>                
                <Label Grid.Row="1" 
                       Grid.Column="1"
                       Content="⇒"
                       FontSize="26" 
                       HorizontalAlignment="Center"/>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        BorderBrush="#FFABADB3"
                        BorderThickness="1"
                        CornerRadius="5">
                    <TextBlock x:Name="txbResult"
                               Foreground="Black"                               
                               Margin="3"
                               TextAlignment="Right" 
                               VerticalAlignment="Center"
                               Text="{Binding Path=LengthCircle}"
                               FontSize="18"
                               Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={StaticResource resultConverter}}"/>                   
                </Border>
                <Label Grid.Row="1" 
                       Grid.Column="2"
                       Content="Длина окружности"
                       HorizontalAlignment="Center"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
