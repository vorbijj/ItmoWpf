<Window x:Class="AnimationBall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimationBall"
        mc:Ignorable="d"
        Title="AnimationBall" Height="500" Width="300">
    <Canvas>
        <Path Data="M63.901345,417.8965 L235.45898,417.8965" 
              Fill="#FFF4F4F5" 
              HorizontalAlignment="Left" 
              Height="1" 
              Stroke="Black" 
              Stretch="Fill" 
              VerticalAlignment="Top" 
              Width="173" 
              Canvas.Left="63.5" 
              Canvas.Bottom="60"/>
        <Ellipse HorizontalAlignment="Center" 
                 Height="40" 
                 Stroke="Black" 
                 VerticalAlignment="Center"
                 Width="40" 
                 Fill="Black" 
                 Canvas.Left="130"
                 Canvas.Bottom="60">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Window.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(Canvas.Bottom)"
                                             To="350"
                                             Duration="0:0:2"
                                             DecelerationRatio="1"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Canvas>
</Window>
