<Window x:Class="ColorIndicator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorIndicator"
        mc:Ignorable="d"
        Title="ColorIndicator" Height="300" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <local:ColorPicker x:Name="colorPicker" 
                           Grid.Row="0"
                           Margin="10"
                           Padding="1"
                           ColorChanged="colorPicker_ColorChanged"/>
        <TextBlock x:Name="txbTitle" 
                   Grid.Row="1" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontSize="26"
                   FontWeight="Bold"
                   Text="Hello World!"/>
        <TextBlock x:Name="txbIndex" 
                   Grid.Row="2" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="16"
                   Text="(#FF000000)"/>
    </Grid>
</Window>
